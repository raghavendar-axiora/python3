version: "3.9"

# On the server, run:  docker compose -f docker-compose.prod.yml up -d
# The CI/CD workflow runs `docker compose pull app && docker compose up -d app`
# from this same directory, so make sure this file is named docker-compose.yml
# (or pass -f explicitly) on the deploy server.

services:
  app:
    image: ghcr.io/OWNER/REPO:latest   # <-- replace OWNER/REPO with your GitHub repo
    container_name: app
    restart: unless-stopped
    ports:
      - "5000:5000"
    environment:
      - PORT=5000
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/health')"]
      interval: 30s
      timeout: 3s
      retries: 3
      start_period: 5s
